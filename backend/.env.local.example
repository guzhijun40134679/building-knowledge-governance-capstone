DEEPSEEK_API_KEY=
# Optional DeepSeek model name. Change it here and restart if the provider retires or upgrades a model.
DEEPSEEK_MODEL=deepseek-chat
# Optional DeepSeek OpenAI-compatible API endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional reasoning mode for the first-pass Welcome Packet analysis. Failures fall back to normal JSON mode.
DEEPSEEK_THINKING_ENABLED=true
# Optional reasoning effort: low / medium / high.
DEEPSEEK_THINKING_REASONING_EFFORT=high
# Optional source-library paths.
PDF_LIBRARY_DIR=pdf_library
SCRIPT_LIBRARY_DIR=script_library
IMAGE_LIBRARY_DIR=image_library
# Optional SQLite database path.
WHITEPAPER_DB_PATH=data/whitepaper.db
# Optional upload directory.
WHITEPAPER_UPLOAD_DIR=data/uploads
# Optional canonical Master and Staging workbook paths.
WHITEPAPER_MASTER_XLSX_PATH=data/master_excel/building_knowledge_master.xlsx
WHITEPAPER_STAGING_XLSX_PATH=data/master_excel/building_knowledge_staging.xlsx
# Optional daemon runtime-status file.
WHITEPAPER_RUNTIME_STATUS_PATH=data/runtime_status.json
# Optional update script and log locations.
WHITEPAPER_UPDATE_SCRIPT=../scripts/update_from_git.sh
WHITEPAPER_UPDATE_LOG_DIR=data/update_logs
WHITEPAPER_UPDATE_RESTART_MARKER=data/restart_requested
# Reserved tunnel health fields. Leave empty unless an operator explicitly configures a tunnel.
WHITEPAPER_TUNNEL_HEALTH_URL=
WHITEPAPER_TUNNEL_NAME=
# Optional response-length limit.
MAX_ANSWER_TOKENS=900
# Comma-separated origins. Localhost only by default; start.command injects LAN origins for that run.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Spreadsheet safety limits.
MAX_SPREADSHEET_ROWS_PER_SHEET=1000
MAX_SPREADSHEET_COLS_PER_SHEET=80
MAX_SPREADSHEET_CELLS_PER_SHEET=20000
# Upload and parsing limits.
WHITEPAPER_MAX_UPLOAD_BYTES=52428800
WHITEPAPER_MAX_IMAGE_UPLOAD_FILES=12
WHITEPAPER_MAX_PDF_PARSE_PAGES=30
WHITEPAPER_PDF_RENDER_TIMEOUT_SECONDS=60
WHITEPAPER_OCR_TIMEOUT_SECONDS=45
WHITEPAPER_VISION_TIMEOUT_SECONDS=45
# Keep disabled. Setting this to 1 accepts the risk of exposing accounts that still use their initial passwords.
WHITEPAPER_ALLOW_DEFAULT_PASSWORD_ON_LAN=0
# Required before the first database initialization. Use a different password of at least 12 characters for each account.
WHITEPAPER_SUPERADMIN_PASSWORD=
WHITEPAPER_ADMIN_PASSWORD=
WHITEPAPER_EMPLOYEE_PASSWORD=
WHITEPAPER_VIEWER_PASSWORD=
# Optional vision review after OCR for images or scanned PDFs.
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=
OCR_PROVIDER=local
OCR_FALLBACK_PROVIDER=local
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_BASE_URL=https://aip.baidubce.com
BAIDU_OCR_POLL_INTERVAL_SECONDS=5
BAIDU_OCR_TIMEOUT_SECONDS=300
# Optional Unlimited-OCR vLLM endpoint on a separate NVIDIA GPU host.
UNLIMITED_OCR_LOCAL_BASE_URL=
UNLIMITED_OCR_LOCAL_MODEL=baidu/Unlimited-OCR
UNLIMITED_OCR_LOCAL_API_KEY=
UNLIMITED_OCR_LOCAL_TIMEOUT_SECONDS=1200
UNLIMITED_OCR_LOCAL_MAX_TOKENS=8192
AI_EXPLANATION_TIMEOUT_SECONDS=15
AI_EXPLANATION_MAX_TOKENS=300
